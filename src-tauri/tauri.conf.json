{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProPadDashboard",
  "version": "3.0.0",
  "identifier": "local.propad.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "手柄电量看板", "width": 360, "height": 288,
      "visible": false, "focus": false, "resizable": false,
      "decorations": false, "alwaysOnTop": true, "skipTaskbar": true,
      "transparent": true, "shadow": false, "noRedirectionBitmap": true,
      "backgroundColor": "#00000000", "zoomHotkeysEnabled": false
    }],
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "手柄电量看板", "longDescription": "支持 Switch Pro、Xbox 和 DualSense 的离线电量和实时输入悬浮看板。",
    "windows": {
      "webviewInstallMode": {"type": "offlineInstaller"},
      "nsis": {"installMode": "currentUser", "languages": ["SimpChinese"], "displayLanguageSelector": false, "installerHooks": "installer.nsh"}
    }
  }
}
